# Пример переменных окружения для бэкенда TWEAK.
# Скопируйте этот файл в .env.local и вставьте свой реальный ключ.
# .env.local в репозиторий не попадает (см. .gitignore).

# Ключ OpenRouter (начинается с sk-or-...)
OPENROUTER_API_KEY=ВСТАВЬТЕ_СВОЙ_КЛЮЧ_OPENROUTER

# Модель ИИ. Для регионов без доступа к OpenAI/Anthropic/Google (например РФ)
# рекомендуем deepseek/deepseek-v4-flash — быстро и дёшево, хорошо держит JSON.
# Качественнее, но медленнее: deepseek/deepseek-v4-pro.
# Альтернативы: x-ai/grok-4.6, qwen/qwen3.8-max, mistralai/mistral-large-2512.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
